# Membership / Authentication Foundation (Phase 2A)
#
# Copy this file to .env.local (gitignored) and fill in real values from
# your Supabase project: Project Settings -> API.
#
# Without these, the site still runs -- LoginPage/AccountPage show a
# "not set up yet" message instead of crashing (see
# src/lib/supabaseClient.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
